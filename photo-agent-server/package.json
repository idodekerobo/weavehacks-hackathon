{
  "name": "photo-agent-server",
  "version": "0.1.0",
  "description": "Local Node.js server for Photos-as-Intent Agent",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:workers\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:workers": "tsx watch src/workers/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/workers/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "photo-agent",
    "weave",
    "browserbase",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^6.16.4",
    "@bull-board/express": "^6.16.4",
    "axios": "^1.13.4",
    "better-sqlite3": "^12.6.2",
    "bull": "^4.16.5",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.9.2",
    "multer": "^2.0.2",
    "uuid": "^13.0.0",
    "weave": "^0.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
